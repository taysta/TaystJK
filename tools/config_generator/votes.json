{
  "_comment": [
    "jaPRO vote options, from the bundled votes.cfg (see sources.json). Players run one with /callvote vstr <id>.",
    "Mode and add-on options are generated for ticked modes only. On/off settings come in explicit pairs; single-bit",
    "startingitems changes stay toggles. {baseline:<cvar>} is replaced with the generated default.cfg's value.",
    "`left_out` lists bundled options not carried over: the bare numeric frag-limit aliases, which duplicate frag0 to frag61."
  ],
  "always": [
    {
      "id": "default",
      "run": "exec default",
      "note": "Back to the baseline"
    },
    {
      "id": "restart",
      "run": "map_restart",
      "note": "Reload the map"
    }
  ],
  "mode_extras": {
    "gungame": [
      {
        "id": "teamgungame",
        "run": "exec gungame;gametype 6;g_friendlyFire 0",
        "note": "Gun game as team FFA without friendly fire"
      }
    ]
  },
